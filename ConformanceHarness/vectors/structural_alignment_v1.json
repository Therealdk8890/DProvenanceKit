{
  "spec_version": "structural-alignment-v1",
  "status": "experimental_contract",
  "metric": {
    "name": "micro_f1",
    "definition": "2*TP/(2*TP+FP+FN)",
    "zero_denominator": 1,
    "zero_denominator_policy": "both_traces_empty_f1_1_empty_input_true_strict_conformance_false",
    "aggregation_unit": "one_target_candidate_trace_comparison",
    "below_threshold_accounting": "target_fn_candidate_fp_no_tp"
  },
  "default_configuration": {
    "weights": {
      "type": 5000,
      "hierarchy": 3000,
      "payload": 2000
    },
    "min_node_conformance": 8000,
    "min_global_f1_floor": 9500,
    "threshold_comparison": "inclusive_integer_comparison",
    "assignment": {
      "strategy": "parent_first_greedy",
      "target_order": "depth_ascending_then_input_sequence_then_target_id",
      "candidate_pair_priority": [
        "node_score_desc",
        "candidate_sequence_asc",
        "candidate_id_lexical",
        "target_sequence_asc",
        "target_id_lexical"
      ],
      "candidate_pool": "all_unassigned_candidates",
      "greedy_is_not_global_optimum": true
    },
    "diagnostic_suggestions": {
      "enabled": true,
      "selected_after_eligible_assignment": true,
      "priority": [
        "node_score_desc",
        "candidate_sequence_asc",
        "candidate_id_lexical"
      ],
      "suggestions_count_as_mappings": false,
      "minimum_node_score_exclusive": 0
    },
    "numeric_representation": "integer_basis_points",
    "basis_points_per_unit": 10000
  },
  "cases": [
