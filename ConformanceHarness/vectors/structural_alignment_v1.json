{
  "spec_version": "structural-alignment-v1",
  "status": "experimental_contract",
  "metric": {
    "name": "micro_f1",
    "definition": "2*TP/(2*TP+FP+FN)",
    "zero_denominator": 0
  },
  "default_configuration": {
    "weights": {
      "type": 0.5,
      "hierarchy": 0.3,
      "payload": 0.2
    },
    "min_node_conformance": 0.8,
    "min_global_f1_floor": 0.95,
    "threshold_comparison": "inclusive",
    "assignment": {
      "strategy": "parent_first_greedy",
      "target_order": "depth_ascending_then_input_sequence_then_target_id",
      "candidate_pair_priority": [
        "node_score_desc",
        "candidate_sequence_asc",
        "candidate_id_lexical",
        "target_sequence_asc",
        "target_id_lexical"
      ],
      "candidate_pool": "all_unassigned_candidates"
    },
    "diagnostic_suggestions": {
      "enabled": true,
      "selected_after_eligible_assignment": true,
      "priority": [
        "node_score_desc",
        "candidate_sequence_asc",
        "candidate_id_lexical"
      ],
      "suggestions_count_as_mappings": false,
      "minimum_node_score_exclusive": 0
    }
  },
  "cases": [
